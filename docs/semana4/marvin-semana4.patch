diff --git a/contracts/marvin/src/lib.rs b/contracts/marvin/src/lib.rs
new file mode 100644
index 0000000..dbf0e15
--- /dev/null
+++ b/contracts/marvin/src/lib.rs
@@ -0,0 +1,169 @@
+//! Contrato de Marvin en Soroban.
+//!
+//! Dos responsabilidades:
+//! 1. Registro de nodos autorizados: el administrador da de alta y revoca las
+//!    llaves públicas ed25519 de los nodos de campo.
+//! 2. Registro de reportes: una puerta de enlace publica el hash de un reporte
+//!    junto con la llave y la firma del nodo que lo generó. El contrato verifica
+//!    en la red que el nodo esté autorizado y que la firma sea válida, rechaza
+//!    duplicados, guarda un registro mínimo y emite un evento.
+//!
+//! En la red nunca se guardan datos del reporte: solo su hash (32 bytes).
+#![no_std]
+
+use soroban_sdk::{
+    contract, contracterror, contractimpl, contracttype, symbol_short, Address, Bytes, BytesN, Env,
+};
+
+/// Tiempo de vida de las entradas persistentes (en ledgers, ~5 s cada uno).
+const TTL_MINIMO: u32 = 100_000; // ~6 días
+const TTL_EXTENDIDO: u32 = 500_000; // ~29 días
+
+#[contracttype]
+#[derive(Clone)]
+enum Clave {
+    Admin,
+    Nodo(BytesN<32>),
+    Reporte(BytesN<32>),
+}
+
+/// Lo que queda en la red por cada reporte.
+#[contracttype]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Registro {
+    /// Llave pública ed25519 del nodo de origen.
+    pub nodo: BytesN<32>,
+    /// 1 víctima · 2 colapso · 3 ruta bloqueada · 4 zona revisada.
+    pub tipo: u32,
+    /// Hash del reporte que este corrige, si corresponde.
+    pub anula: Option<BytesN<32>>,
+    /// Ledger y hora (Unix) en que quedó registrado.
+    pub ledger: u32,
+    pub timestamp: u64,
+    /// Cuenta de la puerta de enlace que lo publicó.
+    pub puerta: Address,
+}
+
+#[contracterror]
+#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]
+#[repr(u32)]
+pub enum Error {
+    NodoNoAutorizado = 1,
+    ReporteDuplicado = 2,
+    TipoInvalido = 3,
+    AnulaInexistente = 4,
+}
+
+#[contract]
+pub struct Marvin;
+
+#[contractimpl]
+impl Marvin {
+    /// Se ejecuta una sola vez, al desplegar el contrato.
+    pub fn __constructor(env: Env, admin: Address) {
+        env.storage().instance().set(&Clave::Admin, &admin);
+    }
+
+    pub fn admin(env: Env) -> Address {
+        env.storage().instance().get(&Clave::Admin).unwrap()
+    }
+
+    /// Da de alta (o reactiva) la llave de un nodo. Solo el administrador.
+    pub fn alta_nodo(env: Env, llave: BytesN<32>) {
+        Self::admin(env.clone()).require_auth();
+        Self::guardar_nodo(&env, &llave, true);
+        #[allow(deprecated)]
+        env.events().publish((symbol_short!("alta"),), llave);
+    }
+
+    /// Revoca la llave de un nodo perdido o robado. Solo el administrador.
+    pub fn revocar_nodo(env: Env, llave: BytesN<32>) {
+        Self::admin(env.clone()).require_auth();
+        Self::guardar_nodo(&env, &llave, false);
+        #[allow(deprecated)]
+        env.events().publish((symbol_short!("revoca"),), llave);
+    }
+
+    pub fn nodo_activo(env: Env, llave: BytesN<32>) -> bool {
+        env.storage()
+            .persistent()
+            .get(&Clave::Nodo(llave))
+            .unwrap_or(false)
+    }
+
+    /// Registra un reporte firmado por un nodo autorizado.
+    /// Devuelve el número de ledger en que quedó registrado.
+    pub fn registrar_reporte(
+        env: Env,
+        puerta: Address,
+        hash: BytesN<32>,
+        llave: BytesN<32>,
+        firma: BytesN<64>,
+        tipo: u32,
+        anula: Option<BytesN<32>>,
+    ) -> Result<u32, Error> {
+        puerta.require_auth();
+
+        if !(1..=4).contains(&tipo) {
+            return Err(Error::TipoInvalido);
+        }
+        if !Self::nodo_activo(env.clone(), llave.clone()) {
+            return Err(Error::NodoNoAutorizado);
+        }
+        let clave = Clave::Reporte(hash.clone());
+        if env.storage().persistent().has(&clave) {
+            return Err(Error::ReporteDuplicado);
+        }
+        if let Some(previo) = &anula {
+            if !env.storage().persistent().has(&Clave::Reporte(previo.clone())) {
+                return Err(Error::AnulaInexistente);
+            }
+        }
+
+        // La firma del nodo es sobre los 32 bytes del hash. Si no es válida,
+        // la ejecución se interrumpe y la transacción falla.
+        let mensaje: Bytes = hash.clone().into();
+        env.crypto().ed25519_verify(&llave, &mensaje, &firma);
+
+        let registro = Registro {
+            nodo: llave.clone(),
+            tipo,
+            anula: anula.clone(),
+            ledger: env.ledger().sequence(),
+            timestamp: env.ledger().timestamp(),
+            puerta,
+        };
+        env.storage().persistent().set(&clave, &registro);
+        env.storage()
+            .persistent()
+            .extend_ttl(&clave, TTL_MINIMO, TTL_EXTENDIDO);
+        env.storage()
+            .instance()
+            .extend_ttl(TTL_MINIMO, TTL_EXTENDIDO);
+
+        #[allow(deprecated)]
+        env.events()
+            .publish((symbol_short!("reporte"), tipo), (hash, llave, anula));
+
+        Ok(registro.ledger)
+    }
+
+    /// Consulta pública: cualquiera puede comprobar si un hash está registrado.
+    pub fn consultar(env: Env, hash: BytesN<32>) -> Option<Registro> {
+        env.storage().persistent().get(&Clave::Reporte(hash))
+    }
+
+    fn guardar_nodo(env: &Env, llave: &BytesN<32>, activo: bool) {
+        let clave = Clave::Nodo(llave.clone());
+        env.storage().persistent().set(&clave, &activo);
+        env.storage()
+            .persistent()
+            .extend_ttl(&clave, TTL_MINIMO, TTL_EXTENDIDO);
+        env.storage()
+            .instance()
+            .extend_ttl(TTL_MINIMO, TTL_EXTENDIDO);
+    }
+}
+
+#[cfg(test)]
+mod test;
diff --git a/contracts/marvin/src/test.rs b/contracts/marvin/src/test.rs
new file mode 100644
index 0000000..1bf35e4
--- /dev/null
+++ b/contracts/marvin/src/test.rs
@@ -0,0 +1,187 @@
+extern crate std;
+
+use super::*;
+use ed25519_dalek::{Signer, SigningKey};
+use soroban_sdk::testutils::{Address as _, Events};
+use soroban_sdk::{BytesN, Env};
+
+struct Escenario {
+    env: Env,
+    cliente: MarvinClient<'static>,
+    puerta: Address,
+}
+
+fn escenario() -> Escenario {
+    let env = Env::default();
+    env.mock_all_auths();
+    let admin = Address::generate(&env);
+    let id = env.register(Marvin, (admin.clone(),));
+    let cliente = MarvinClient::new(&env, &id);
+    let puerta = Address::generate(&env);
+    Escenario { env, cliente, puerta }
+}
+
+fn nodo(semilla: u8) -> SigningKey {
+    SigningKey::from_bytes(&[semilla; 32])
+}
+
+fn llave(env: &Env, n: &SigningKey) -> BytesN<32> {
+    BytesN::from_array(env, &n.verifying_key().to_bytes())
+}
+
+fn firmado(env: &Env, n: &SigningKey, contenido: u8) -> (BytesN<32>, BytesN<64>) {
+    let hash = [contenido; 32];
+    let firma = n.sign(&hash).to_bytes();
+    (BytesN::from_array(env, &hash), BytesN::from_array(env, &firma))
+}
+
+#[test]
+fn registra_un_reporte_valido_y_se_puede_consultar() {
+    let e = escenario();
+    let n = nodo(1);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    let (hash, firma) = firmado(&e.env, &n, 7);
+
+    let ledger = e
+        .cliente
+        .registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &1, &None);
+    assert_eq!(e.env.events().all().len(), 1);
+
+    let r = e.cliente.consultar(&hash).unwrap();
+    assert_eq!(r.ledger, ledger);
+    assert_eq!(r.tipo, 1);
+    assert_eq!(r.nodo, llave(&e.env, &n));
+    assert_eq!(r.puerta, e.puerta);
+}
+
+#[test]
+fn rechaza_un_nodo_no_registrado() {
+    let e = escenario();
+    let n = nodo(2);
+    let (hash, firma) = firmado(&e.env, &n, 1);
+    let r = e
+        .cliente
+        .try_registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &2, &None);
+    assert_eq!(r, Err(Ok(Error::NodoNoAutorizado)));
+}
+
+#[test]
+fn rechaza_un_nodo_revocado() {
+    let e = escenario();
+    let n = nodo(3);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    assert!(e.cliente.nodo_activo(&llave(&e.env, &n)));
+    e.cliente.revocar_nodo(&llave(&e.env, &n));
+    assert!(!e.cliente.nodo_activo(&llave(&e.env, &n)));
+    let (hash, firma) = firmado(&e.env, &n, 1);
+    let r = e
+        .cliente
+        .try_registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &3, &None);
+    assert_eq!(r, Err(Ok(Error::NodoNoAutorizado)));
+}
+
+#[test]
+fn rechaza_duplicados() {
+    let e = escenario();
+    let n = nodo(4);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    let (hash, firma) = firmado(&e.env, &n, 9);
+    e.cliente
+        .registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &4, &None);
+    let r = e
+        .cliente
+        .try_registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &4, &None);
+    assert_eq!(r, Err(Ok(Error::ReporteDuplicado)));
+}
+
+#[test]
+fn rechaza_tipo_invalido() {
+    let e = escenario();
+    let n = nodo(5);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    let (hash, firma) = firmado(&e.env, &n, 9);
+    let r = e
+        .cliente
+        .try_registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &9, &None);
+    assert_eq!(r, Err(Ok(Error::TipoInvalido)));
+}
+
+#[test]
+fn una_correccion_debe_apuntar_a_un_reporte_registrado() {
+    let e = escenario();
+    let n = nodo(6);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    let (original, f1) = firmado(&e.env, &n, 1);
+    let (correccion, f2) = firmado(&e.env, &n, 2);
+    let (fantasma, _) = firmado(&e.env, &n, 3);
+
+    let r = e.cliente.try_registrar_reporte(
+        &e.puerta, &correccion, &llave(&e.env, &n), &f2, &1, &Some(fantasma),
+    );
+    assert_eq!(r, Err(Ok(Error::AnulaInexistente)));
+
+    e.cliente
+        .registrar_reporte(&e.puerta, &original, &llave(&e.env, &n), &f1, &1, &None);
+    e.cliente.registrar_reporte(
+        &e.puerta, &correccion, &llave(&e.env, &n), &f2, &1, &Some(original.clone()),
+    );
+    assert_eq!(e.cliente.consultar(&correccion).unwrap().anula, Some(original));
+}
+
+#[test]
+#[should_panic]
+fn rechaza_una_firma_falsa() {
+    let e = escenario();
+    let n = nodo(7);
+    let impostor = nodo(8);
+    e.cliente.alta_nodo(&llave(&e.env, &n));
+    // El impostor firma, pero se presenta con la llave del nodo autorizado.
+    let (hash, firma) = firmado(&e.env, &impostor, 5);
+    e.cliente
+        .registrar_reporte(&e.puerta, &hash, &llave(&e.env, &n), &firma, &1, &None);
+}
+
+#[test]
+#[should_panic]
+fn solo_el_admin_da_de_alta_nodos() {
+    let env = Env::default();
+    let admin = Address::generate(&env);
+    let id = env.register(Marvin, (admin,));
+    let cliente = MarvinClient::new(&env, &id);
+    // Sin autorización del admin.
+    cliente.alta_nodo(&BytesN::from_array(&env, &[1; 32]));
+}
+
+#[test]
+fn consultar_un_hash_desconocido_devuelve_none() {
+    let e = escenario();
+    assert_eq!(e.cliente.consultar(&BytesN::from_array(&e.env, &[0; 32])), None);
+}
+
+/// Carga el .wasm compilado (si existe) en el host de Soroban y repite el flujo
+/// principal, para comprobar que el binario que se despliega es válido.
+#[test]
+fn el_wasm_compilado_funciona_en_el_host() {
+    let ruta = concat!(env!("CARGO_MANIFEST_DIR"), "/../target/wasm32v1-none/release/marvin.wasm");
+    let Ok(wasm) = std::fs::read(ruta) else {
+        std::println!("(sin wasm compilado, se omite)");
+        return;
+    };
+    let env = Env::default();
+    env.mock_all_auths();
+    let admin = Address::generate(&env);
+    let id = env.register(wasm.as_slice(), (admin.clone(),));
+    let cliente = MarvinClient::new(&env, &id);
+    assert_eq!(cliente.admin(), admin);
+    let n = nodo(9);
+    cliente.alta_nodo(&llave(&env, &n));
+    let (hash, firma) = firmado(&env, &n, 4);
+    let puerta = Address::generate(&env);
+    cliente.registrar_reporte(&puerta, &hash, &llave(&env, &n), &firma, &2, &None);
+    assert_eq!(cliente.consultar(&hash).unwrap().tipo, 2);
+    let (h2, _) = firmado(&env, &n, 5);
+    let (_, firma_mala) = firmado(&env, &nodo(10), 5);
+    assert!(cliente
+        .try_registrar_reporte(&puerta, &h2, &llave(&env, &n), &firma_mala, &1, &None)
+        .is_err());
+}
